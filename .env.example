# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Dashboard → Project Settings → API Keys)
# Use the new sb_* keys OR legacy JWT anon/service_role keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Client-safe (publishable / anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alias (optional if you use JWT anon key instead):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — REQUIRED for saving audits (secret / service_role — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Legacy alias:
# SUPABASE_SECRET_KEY=sb_secret_...

# Resend (transactional email)
RESEND_API_KEY=re_j9RzJYB2_Bx4YDzL59xmirX7RahTWfFV8
RESEND_FROM_EMAIL=onboarding@resend.dev

# AI audit summary (optional)
CREDITFLOW_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_SUMMARY_MODEL=claude-3-5-haiku-20241022
